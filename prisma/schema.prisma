// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gender {
  male
  female
  other
}

enum WardType {
  General
  ICU
  Maternity
  Pediatric
}

enum AssignmentStatus {
  active
  discharged
  transferred
}

model Patient {
  id          Int          @id @default(autoincrement())
  fullName    String       @map("full_name") @db.VarChar(120)
  dateOfBirth DateTime     @map("date_of_birth") @db.Date
  gender      Gender
  phone       String?      @unique @db.VarChar(20)
  email       String?      @unique @db.VarChar(150)
  address     String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  assignments Assignment[]

  @@map("patients")
}

model Ward {
  id               Int          @id @default(autoincrement())
  name             String       @unique @db.VarChar(80)
  wardType         WardType     @map("ward_type")
  capacity         Int
  currentOccupancy Int          @default(0) @map("current_occupancy")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  assignments      Assignment[]

  // NOTE: Prisma does not support CHECK constraints natively.
  // Run prisma/migrations/0001_add_check_constraint.sql manually after migrate dev.
  @@map("wards")
}

model Doctor {
  id             Int          @id @default(autoincrement())
  fullName       String       @map("full_name") @db.VarChar(120)
  specialization String       @db.VarChar(80)
  email          String?      @unique @db.VarChar(150)
  phone          String?      @db.VarChar(20)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  assignments    Assignment[]

  @@map("doctors")
}

model Assignment {
  id           Int              @id @default(autoincrement())
  patientId    Int              @map("patient_id")
  wardId       Int              @map("ward_id")
  doctorId     Int?             @map("doctor_id")
  assignedAt   DateTime         @default(now()) @map("assigned_at")
  dischargedAt DateTime?        @map("discharged_at")
  status       AssignmentStatus @default(active)
  notes        String?
  patient      Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  ward         Ward             @relation(fields: [wardId], references: [id], onDelete: Restrict)
  doctor       Doctor?          @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([wardId])
  @@index([doctorId])
  @@map("assignments")
}
